# Backend environment variables
SECRET_KEY=your-secret-key-here
API_HOST=0.0.0.0
API_PORT=8000
TEMP_FILE_DIR=./temp_presentations

# LLM Provider Configuration
# Options: ollama, groq, openai, anthropic
LLM_PROVIDER=groq
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# Ollama Configuration (for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Groq Configuration (for fast cloud inference)
GROQ_API_KEY=your-groq-api-key-here
# Available models: llama-3.3-70b-versatile, mixtral-8x7b-32768, openai/gpt-oss-120b
GROQ_MODEL=llama-3.3-70b-versatile

# API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Agent Configuration
MAX_ITERATIONS=5
QUALITY_THRESHOLD=0.8

# Timeout Configuration (seconds)
PLANNER_TIMEOUT=30
CONTENT_TIMEOUT=40
REVIEWER_TIMEOUT=40
DESIGN_TIMEOUT=30
PIPELINE_TIMEOUT=120

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY=2
